<Window x:Class="CybersecurityAwarenessBot.GUI.TaskListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Task Assistant"
        Height="750"
        Width="850"
        MinHeight="650"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">

    <Window.Resources>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#34D399"/>
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26364D"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="CYBERSECURITY TASK ASSISTANT"
                       Foreground="#34D399"
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock Text="Organise your cybersecurity activities and stay protected."
                       Foreground="#94A3B8"
                       FontSize="13"
                       Margin="0,7,0,0"/>

        </StackPanel>

        <!-- ADD TASK -->
        <Border Grid.Row="1"
                Background="#101A2B"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CREATE A SECURITY TASK"
                           Foreground="#94A3B8"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TaskInput"
                             Grid.Row="0"
                             Grid.Column="0"
                             Height="44"
                             Padding="10"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Background="#172338"
                             Foreground="#F1F5F9"
                             BorderBrush="#26364D"
                             ToolTip="Enter a cybersecurity task"/>

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Content="+ ADD TASK"
                            Click="AddTaskButton_Click"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,12,0,0">

                        <TextBlock Text="REMINDER DATE (OPTIONAL)"
                                   Foreground="#94A3B8"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>

                        <DatePicker x:Name="ReminderDatePicker"
                                    Height="35"
                                    SelectedDateFormat="Short"
                                    ToolTip="Choose when you want to be reminded"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

        <!-- TASK LIST -->
        <Border Grid.Row="2"
                Background="#101A2B"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="YOUR SECURITY TASKS"
                           Foreground="#34D399"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <ListBox x:Name="TaskList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F1F5F9"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#172338"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8">

                                <StackPanel>

                                    <CheckBox Content="{Binding Description}"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Checked="TaskCheckBox_Changed"
                                              Unchecked="TaskCheckBox_Changed"
                                              Foreground="#F1F5F9"
                                              FontSize="14"
                                              FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding ReminderDate, StringFormat='Reminder: {0:d}'}"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               Margin="23,5,0,0"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- PROGRESS -->
        <TextBlock x:Name="ProgressText"
                   Grid.Row="3"
                   Text="Completed: 0 of 0 tasks"
                   Foreground="#34D399"
                   FontSize="13"
                   FontWeight="Bold"
                   Margin="0,16,0,14"/>

        <!-- ACTION BUTTONS -->
        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Right">

            <Button Content="REMOVE SELECTED"
                    Click="RemoveTaskButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"/>

            <Button Content="CLEAR COMPLETED"
                    Click="ClearCompletedButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"/>

            <Button Content="CLOSE"
                    Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>

        </WrapPanel>

    </Grid>

</Window>
