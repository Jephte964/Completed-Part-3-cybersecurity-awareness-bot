<Window x:Class="CybersecurityAwarenessBot.GUI.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activity Log"
        Height="550"
        Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#080E1A"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ACTIVITY HISTORY"
                       Foreground="#34D399"
                       FontSize="12"
                       FontWeight="Bold"/>

            <TextBlock Text="Recent Security Activities"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,7,0,5"/>

            <TextBlock Text="View the latest 10 actions performed in the application."
                       Foreground="#94A3B8"
                       FontSize="12"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#101A2B"
                BorderBrush="#263750"
                BorderThickness="1"
                CornerRadius="12"
                Padding="15">

            <ListBox x:Name="ActivityList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E2E8F0"
                     FontSize="14"
                     Padding="5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="REFRESH"
                    Padding="18,10"
                    Margin="0,0,10,0"
                    Background="#24334B"
                    Foreground="White"
                    BorderThickness="0"
                    Click="RefreshButton_Click"/>

            <Button Content="CLOSE"
                    Padding="18,10"
                    Background="#34D399"
                    Foreground="#07111F"
                    BorderThickness="0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
